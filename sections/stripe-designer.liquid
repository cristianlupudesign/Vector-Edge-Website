{%- comment -%}
  Speed Army: wheel rim stripe designer.
  Customer picks wheel sizes, stripe style, breaks, width, vinyl colours and optional rim text,
  sees a live SVG preview of the wheel, then adds the kit to cart. Every choice travels on the
  line item as properties, plus a short design code and a link that reopens the exact design.
  Preview only: no cut files are generated. Renders inside the normal theme layout. Vanilla JS only.
{%- endcomment -%}

{%- liquid
  assign sd_product = section.settings.product
  assign sd_addon = section.settings.text_addon_product
  assign sd_uid = 'sd-' | append: section.id
-%}

<style>
  #shopify-section-{{ section.id }} .sd {
    --sd-accent: {{ section.settings.accent | default: '#D0121B' }};
    --sd-ink: #161616;
    --sd-muted: #5c5c5c;
    --sd-rule: #dcdcdc;
    --sd-panel: #f5f5f4;
    --sd-white: #ffffff;
    font-family: inherit;
    color: var(--sd-ink);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  #shopify-section-{{ section.id }} .sd *,
  #shopify-section-{{ section.id }} .sd *::before,
  #shopify-section-{{ section.id }} .sd *::after { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .sd-inner { max-width: 1200px; margin: 0 auto; padding: 4rem 2rem 6.4rem; }

  /* ---- Header ---- */
  #shopify-section-{{ section.id }} .sd-eyebrow {
    display: inline-block; font-size: 1.3rem; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--sd-accent); margin: 0 0 1rem;
  }
  #shopify-section-{{ section.id }} .sd h1 {
    font-size: clamp(3.2rem, 5vw, 5rem); line-height: 1; text-transform: uppercase;
    letter-spacing: 0.01em; margin: 0 0 1.4rem;
  }
  #shopify-section-{{ section.id }} .sd-intro { font-size: 1.7rem; color: var(--sd-muted); max-width: 64ch; margin-bottom: 3.2rem; }
  #shopify-section-{{ section.id }} .sd-intro p { margin: 0 0 1rem; }

  /* ---- Layout ---- */
  #shopify-section-{{ section.id }} .sd-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; align-items: start; }
  @media (max-width: 899px) {
    #shopify-section-{{ section.id }} .sd-grid { grid-template-columns: minmax(0, 1fr); gap: 2.4rem; }
  }

  /* ---- Preview ---- */
  #shopify-section-{{ section.id }} .sd-stage {
    position: sticky; top: 2rem; background: var(--sd-panel); border-radius: 12px; padding: 2rem;
  }
  @media (max-width: 899px) {
    #shopify-section-{{ section.id }} .sd-stage { position: static; }
  }
  #shopify-section-{{ section.id }} .sd-stage__bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.2rem; flex-wrap: wrap; }
  #shopify-section-{{ section.id }} .sd-svg { display: block; width: 100%; max-width: 520px; height: auto; margin: 0 auto; }
  #shopify-section-{{ section.id }} .sd-wheel { transform-box: fill-box; transform-origin: center; }
  #shopify-section-{{ section.id }} .sd-wheel.is-spinning { animation: sd-spin-{{ section.id }} 6s linear infinite; }
  @keyframes sd-spin-{{ section.id }} { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .sd-wheel.is-spinning { animation: none; }
  }
  #shopify-section-{{ section.id }} .sd-caption { text-align: center; font-size: 1.3rem; color: var(--sd-muted); margin: 1rem 0 0; }
  #shopify-section-{{ section.id }} .sd-code {
    display: flex; align-items: center; justify-content: center; gap: 1rem; flex-wrap: wrap;
    margin-top: 1.2rem; font-size: 1.3rem;
  }
  #shopify-section-{{ section.id }} .sd-code code { font-family: ui-monospace, Menlo, Consolas, monospace; background: var(--sd-white); padding: 0.3rem 0.8rem; border-radius: 4px; }

  /* ---- Controls ---- */
  #shopify-section-{{ section.id }} .sd-form { margin: 0; }
  #shopify-section-{{ section.id }} .sd-step { border: 0; padding: 0 0 2.2rem; margin: 0 0 2.2rem; border-bottom: 1px solid var(--sd-rule); min-width: 0; }
  #shopify-section-{{ section.id }} .sd-step:last-of-type { border-bottom: 0; }
  #shopify-section-{{ section.id }} .sd-step legend,
  #shopify-section-{{ section.id }} .sd-label {
    display: block; font-size: 1.4rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    margin: 0 0 1rem; padding: 0;
  }
  #shopify-section-{{ section.id }} .sd-step legend span { color: var(--sd-accent); margin-right: 0.6rem; }
  #shopify-section-{{ section.id }} .sd-hint { font-size: 1.3rem; color: var(--sd-muted); margin: 0.6rem 0 0; }
  #shopify-section-{{ section.id }} .sd-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  #shopify-section-{{ section.id }} .sd-field { margin-bottom: 1.4rem; }
  #shopify-section-{{ section.id }} .sd-field:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .sd-sublabel { display: block; font-size: 1.3rem; font-weight: 600; margin-bottom: 0.5rem; }
  #shopify-section-{{ section.id }} .sd-input,
  #shopify-section-{{ section.id }} .sd-select {
    width: 100%; padding: 1rem 1.2rem; font: inherit; font-size: 1.5rem; color: var(--sd-ink);
    background: var(--sd-white); border: 1px solid #c4c4c4; border-radius: 6px;
  }
  #shopify-section-{{ section.id }} .sd-input[aria-invalid="true"] { border-color: #b00020; }
  #shopify-section-{{ section.id }} .sd-error { color: #b00020; font-size: 1.3rem; margin: 0.6rem 0 0; }

  /* Segmented radios */
  #shopify-section-{{ section.id }} .sd-seg { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  #shopify-section-{{ section.id }} .sd-seg input { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
  #shopify-section-{{ section.id }} .sd-seg label {
    flex: 1 1 auto; min-width: 9rem; text-align: center; cursor: pointer; font-size: 1.4rem; font-weight: 600;
    padding: 1rem 1.2rem; border: 1px solid #c4c4c4; border-radius: 6px; background: var(--sd-white);
    transition: border-color .15s, background .15s, color .15s;
  }
  #shopify-section-{{ section.id }} .sd-seg label small { display: block; font-weight: 400; font-size: 1.2rem; color: var(--sd-muted); }
  #shopify-section-{{ section.id }} .sd-seg input:checked + label { border-color: var(--sd-ink); background: var(--sd-ink); color: var(--sd-white); }
  #shopify-section-{{ section.id }} .sd-seg input:checked + label small { color: #d6d6d6; }
  #shopify-section-{{ section.id }} .sd-seg input:focus-visible + label { outline: 3px solid var(--sd-accent); outline-offset: 2px; }

  /* Swatches */
  #shopify-section-{{ section.id }} .sd-swatches { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  #shopify-section-{{ section.id }} .sd-swatches input { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
  #shopify-section-{{ section.id }} .sd-swatches label {
    width: 4rem; height: 4rem; border-radius: 50%; cursor: pointer; position: relative;
    border: 1px solid rgba(0,0,0,.25); box-shadow: inset 0 -6px 10px rgba(0,0,0,.12), inset 0 4px 8px rgba(255,255,255,.35);
  }
  #shopify-section-{{ section.id }} .sd-swatches input:checked + label { box-shadow: 0 0 0 3px var(--sd-white), 0 0 0 5px var(--sd-ink); }
  #shopify-section-{{ section.id }} .sd-swatches input:focus-visible + label { outline: 3px solid var(--sd-accent); outline-offset: 4px; }
  #shopify-section-{{ section.id }} .sd-swatch-name { font-size: 1.3rem; margin: 0.8rem 0 0; color: var(--sd-muted); }
  #shopify-section-{{ section.id }} .sd-swatch-name strong { color: var(--sd-ink); }

  /* Range */
  #shopify-section-{{ section.id }} .sd-range { display: flex; align-items: center; gap: 1.2rem; }
  #shopify-section-{{ section.id }} .sd-range input[type="range"] { flex: 1 1 auto; accent-color: var(--sd-accent); }
  #shopify-section-{{ section.id }} .sd-range output { min-width: 5.6rem; text-align: right; font-weight: 700; font-variant-numeric: tabular-nums; }

  /* Toggle */
  #shopify-section-{{ section.id }} .sd-toggle { display: inline-flex; align-items: center; gap: 0.6rem; font-size: 1.3rem; cursor: pointer; }
  #shopify-section-{{ section.id }} .sd-toggle input { accent-color: var(--sd-accent); width: 1.6rem; height: 1.6rem; }

  /* ---- Buy box ---- */
  #shopify-section-{{ section.id }} .sd-buy { background: var(--sd-panel); border-radius: 12px; padding: 2rem; }
  #shopify-section-{{ section.id }} .sd-price-row { display: flex; justify-content: space-between; font-size: 1.4rem; color: var(--sd-muted); margin-bottom: 0.4rem; }
  #shopify-section-{{ section.id }} .sd-price-row--total { font-size: 2rem; font-weight: 700; color: var(--sd-ink); border-top: 1px solid var(--sd-rule); padding-top: 1rem; margin: 1rem 0 1.6rem; }
  #shopify-section-{{ section.id }} .sd-btn {
    display: flex; width: 100%; align-items: center; justify-content: center; gap: 0.8rem;
    font: inherit; font-size: 1.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 1.5rem 2rem; border: 2px solid var(--sd-accent); border-radius: 6px; cursor: pointer;
    background: var(--sd-accent); color: var(--sd-white); text-decoration: none;
  }
  #shopify-section-{{ section.id }} .sd-btn:hover { filter: brightness(0.92); }
  #shopify-section-{{ section.id }} .sd-btn[disabled] { opacity: .6; cursor: progress; }
  #shopify-section-{{ section.id }} .sd-btn--ghost { background: transparent; color: var(--sd-ink); border-color: var(--sd-ink); font-size: 1.3rem; padding: 0.6rem 1.2rem; width: auto; display: inline-flex; }
  #shopify-section-{{ section.id }} .sd-btn:focus-visible,
  #shopify-section-{{ section.id }} .sd-input:focus-visible,
  #shopify-section-{{ section.id }} .sd-select:focus-visible { outline: 3px solid var(--sd-accent); outline-offset: 2px; }
  #shopify-section-{{ section.id }} .sd-status { font-size: 1.4rem; margin: 1rem 0 0; min-height: 2rem; }
  #shopify-section-{{ section.id }} .sd-status.is-error { color: #b00020; }
  #shopify-section-{{ section.id }} .sd-notes { list-style: none; margin: 1.6rem 0 0; padding: 0; font-size: 1.35rem; color: var(--sd-muted); }
  #shopify-section-{{ section.id }} .sd-notes li { padding-left: 2rem; position: relative; margin-bottom: 0.5rem; }
  #shopify-section-{{ section.id }} .sd-notes li::before { content: ""; position: absolute; left: 0.2rem; top: 0.7rem; width: 0.9rem; height: 0.5rem; border-left: 2px solid var(--sd-accent); border-bottom: 2px solid var(--sd-accent); transform: rotate(-45deg); }
  #shopify-section-{{ section.id }} .sd-merchant { background: #fff4d6; border: 1px solid #e3c35a; border-radius: 6px; padding: 1rem 1.2rem; font-size: 1.3rem; margin-bottom: 1.6rem; }
  #shopify-section-{{ section.id }} [hidden] { display: none !important; }
</style>

<div class="sd" id="{{ sd_uid }}">
  <div class="sd-inner">
    {%- if section.settings.eyebrow != blank -%}<p class="sd-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h1>{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.intro != blank -%}<div class="sd-intro">{{ section.settings.intro }}</div>{%- endif -%}

    <div class="sd-grid">
      {%- comment -%} ---- Live preview ---- {%- endcomment -%}
      <div class="sd-stage">
        <div class="sd-stage__bar">
          <div class="sd-seg" role="radiogroup" aria-label="Preview wheel">
            <input type="radio" name="{{ sd_uid }}-view" id="{{ sd_uid }}-view-front" value="front" data-sd="view" checked>
            <label for="{{ sd_uid }}-view-front">Front</label>
            <input type="radio" name="{{ sd_uid }}-view" id="{{ sd_uid }}-view-rear" value="rear" data-sd="view">
            <label for="{{ sd_uid }}-view-rear">Rear</label>
          </div>
          <label class="sd-toggle"><input type="checkbox" data-sd="spin"> Spin</label>
        </div>
        <svg class="sd-svg" viewBox="0 0 400 400" role="img" aria-labelledby="{{ sd_uid }}-svg-title" data-sd-svg>
          <title id="{{ sd_uid }}-svg-title">Wheel stripe preview</title>
          <g class="sd-wheel" data-sd-wheel></g>
          <g data-sd-fixed></g>
        </svg>
        <p class="sd-caption">Preview only. Proportions are to scale for your wheel size; colours vary slightly on screen.</p>
        <div class="sd-code">
          <span>Design code <code data-sd-code></code></span>
          <button type="button" class="sd-btn sd-btn--ghost" data-sd-share>Copy design link</button>
        </div>
      </div>

      {%- comment -%} ---- Controls ---- {%- endcomment -%}
      <form class="sd-form" data-sd-form novalidate>
        <fieldset class="sd-step">
          <legend><span>01</span>Your bike</legend>
          <div class="sd-field">
            <label class="sd-sublabel" for="{{ sd_uid }}-bike">Make, model and year</label>
            <input class="sd-input" type="text" id="{{ sd_uid }}-bike" data-sd="bike" maxlength="60" autocomplete="off" placeholder="e.g. Yamaha MT-07 2021" aria-describedby="{{ sd_uid }}-bike-hint {{ sd_uid }}-bike-err">
            <p class="sd-hint" id="{{ sd_uid }}-bike-hint">We cut every kit to your exact rim, so we need the bike.</p>
            <p class="sd-error" id="{{ sd_uid }}-bike-err" data-sd-bike-err hidden>Please tell us the bike so we can cut the kit to fit.</p>
          </div>
          <div class="sd-row">
            <div class="sd-field">
              <label class="sd-sublabel" for="{{ sd_uid }}-front">Front wheel</label>
              <select class="sd-select" id="{{ sd_uid }}-front" data-sd="front"></select>
            </div>
            <div class="sd-field">
              <label class="sd-sublabel" for="{{ sd_uid }}-rear">Rear wheel</label>
              <select class="sd-select" id="{{ sd_uid }}-rear" data-sd="rear"></select>
            </div>
          </div>
          <p class="sd-hint">Not sure? The size is on the tyre sidewall, e.g. 120/70 <strong>ZR17</strong> is a 17&Prime; wheel.</p>
        </fieldset>

        <fieldset class="sd-step">
          <legend><span>02</span>Stripe style</legend>
          <div class="sd-seg" data-sd-styles></div>
          <div class="sd-field" data-sd-breaks-wrap style="margin-top:1.4rem">
            <label class="sd-sublabel" for="{{ sd_uid }}-breaks">Pieces per side</label>
            <div class="sd-range">
              <input type="range" id="{{ sd_uid }}-breaks" data-sd="breaks" min="2" max="8" step="1">
              <output data-sd-out="breaks"></output>
            </div>
          </div>
          <div class="sd-field" data-sd-gap-wrap>
            <label class="sd-sublabel" for="{{ sd_uid }}-gap">Gap between pieces</label>
            <div class="sd-range">
              <input type="range" id="{{ sd_uid }}-gap" data-sd="gap" min="2" max="24" step="1">
              <output data-sd-out="gap"></output>
            </div>
          </div>
          <div class="sd-field">
            <span class="sd-sublabel" id="{{ sd_uid }}-width-l">Stripe width</span>
            <div class="sd-seg" role="radiogroup" aria-labelledby="{{ sd_uid }}-width-l" data-sd-widths></div>
          </div>
        </fieldset>

        <fieldset class="sd-step">
          <legend><span>03</span>Colours</legend>
          <div class="sd-field">
            <span class="sd-sublabel" id="{{ sd_uid }}-colour-l">Stripe colour</span>
            <div class="sd-swatches" role="radiogroup" aria-labelledby="{{ sd_uid }}-colour-l" data-sd-swatches="colour"></div>
            <p class="sd-swatch-name" data-sd-name="colour"></p>
          </div>
          <div class="sd-field" data-sd-accent-wrap>
            <span class="sd-sublabel" id="{{ sd_uid }}-accent-l" data-sd-accent-label>Second colour</span>
            <div class="sd-swatches" role="radiogroup" aria-labelledby="{{ sd_uid }}-accent-l" data-sd-swatches="accent"></div>
            <p class="sd-swatch-name" data-sd-name="accent"></p>
          </div>
          <div class="sd-field">
            <span class="sd-sublabel" id="{{ sd_uid }}-rim-l">Your rim colour <small>(preview only)</small></span>
            <div class="sd-swatches" role="radiogroup" aria-labelledby="{{ sd_uid }}-rim-l" data-sd-swatches="rim"></div>
            <p class="sd-swatch-name" data-sd-name="rim"></p>
          </div>
        </fieldset>

        {%- if section.settings.enable_text -%}
        <fieldset class="sd-step">
          <legend><span>04</span>Rim text <small style="font-weight:400;text-transform:none;letter-spacing:0">(optional)</small></legend>
          <div class="sd-field">
            <label class="sd-sublabel" for="{{ sd_uid }}-text">Text set into the stripe</label>
            <input class="sd-input" type="text" id="{{ sd_uid }}-text" data-sd="text" maxlength="14" autocomplete="off" placeholder="e.g. RACING or your name" aria-describedby="{{ sd_uid }}-text-hint">
            <p class="sd-hint" id="{{ sd_uid }}-text-hint">Up to 14 letters, numbers or spaces. Cut in your second colour.{% if sd_addon != blank %} Adds {{ sd_addon.selected_or_first_available_variant.price | money }}.{% endif %}</p>
          </div>
        </fieldset>
        {%- endif -%}

        <div class="sd-buy">
          {%- if request.design_mode and sd_product == blank -%}
            <p class="sd-merchant"><strong>Store owner:</strong> pick the wheel stripe kit product in this section's settings. Until then the button sends customers to the quote page.</p>
          {%- endif -%}

          <fieldset class="sd-step" data-sd-coverage-wrap style="border:0;padding:0;margin:0 0 1.6rem">
            <legend>Kit</legend>
            <div class="sd-seg" data-sd-coverage></div>
          </fieldset>

          <div data-sd-pricebox>
            <div class="sd-price-row"><span>Stripe kit</span><span data-sd-price="kit"></span></div>
            <div class="sd-price-row" data-sd-price-addon-row hidden><span>Rim text</span><span data-sd-price="addon"></span></div>
            <div class="sd-price-row sd-price-row--total"><span>Total</span><span data-sd-price="total" aria-live="polite"></span></div>
          </div>

          <button type="submit" class="sd-btn" data-sd-submit>{{ section.settings.button_label | escape }}</button>
          <p class="sd-status" data-sd-status role="status" aria-live="polite"></p>

          {%- if section.settings.notes != blank -%}
            <ul class="sd-notes">
              {%- assign sd_notes = section.settings.notes | newline_to_br | split: '<br />' -%}
              {%- for note in sd_notes -%}
                {%- assign n = note | strip -%}
                {%- if n != blank -%}<li>{{ n | escape }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </form>
    </div>
  </div>

  <script type="application/json" data-sd-config>
    {
      "product": {% if sd_product != blank %}{{ sd_product | json }}{% else %}null{% endif %},
      "addon": {% if sd_addon != blank %}{{ sd_addon | json }}{% else %}null{% endif %},
      "moneyFormat": {{ shop.money_format | json }},
      "quoteUrl": {{ section.settings.quote_url | default: '/pages/contact' | json }},
      "cartUrl": {{ routes.cart_url | json }},
      "cartAddUrl": {{ routes.cart_add_url | append: '.js' | json }},
      "afterAdd": {{ section.settings.after_add | json }},
      "colours": [
        {%- for block in section.blocks -%}
          {%- if block.type == 'colour' -%}
            {"name": {{ block.settings.name | json }}, "hex": {{ block.settings.hex | json }}, "accentOnly": {% if block.settings.accent_only %}true{% else %}false{% endif %}}{% unless forloop.last %},{% endunless %}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
</div>

<script>
  (function () {
    var root = document.getElementById('{{ sd_uid }}');
    if (!root) return;
    var cfgEl = root.querySelector('[data-sd-config]');
    var cfg;
    try { cfg = JSON.parse(cfgEl.textContent); } catch (e) { return; }

    var SVGNS = 'http://www.w3.org/2000/svg';
    var UID = '{{ sd_uid }}';

    // ---- Options ----
    var FRONT_SIZES = [12, 13, 14, 15, 16, 17, 18, 19, 21, 23];
    var REAR_SIZES = [12, 13, 14, 15, 16, 17, 18, 19];
    var STYLES = [
      { id: 'full', label: 'Full ring', hint: 'One unbroken line', code: 'FUL' },
      { id: 'segments', label: 'Segments', hint: 'Evenly broken', code: 'SEG' },
      { id: 'tapered', label: 'Tapered', hint: 'Blade ends', code: 'TAP' },
      { id: 'twin', label: 'Twin line', hint: 'Two colours', code: 'TWN' }
    ];
    var WIDTHS = [5, 7, 10, 12];
    var RIMS = [
      { name: 'Black', hex: '#1d1d1f' },
      { name: 'Silver', hex: '#b9bcc0' },
      { name: 'Gunmetal', hex: '#4a4e54' },
      { name: 'White', hex: '#ececea' },
      { name: 'Gold', hex: '#b8913f' },
      { name: 'Blue', hex: '#1d3f8f' },
      { name: 'Red', hex: '#9e1a1f' },
      { name: 'Orange', hex: '#e2621b' }
    ];
    var COLOURS = (cfg.colours || []).filter(function (c) { return c && c.name && /^#[0-9a-f]{3,8}$/i.test(c.hex || ''); });
    if (!COLOURS.length) {
      COLOURS = [
        { name: 'Gloss White', hex: '#f5f5f3' }, { name: 'Gloss Black', hex: '#111111' },
        { name: 'Red', hex: '#d0121b' }, { name: 'Yellow', hex: '#ffd100' }
      ];
    }
    var STRIPE_COLOURS = COLOURS.filter(function (c) { return !c.accentOnly; });
    if (!STRIPE_COLOURS.length) STRIPE_COLOURS = COLOURS;

    var state = {
      view: 'front', spin: false, bike: '',
      front: 17, rear: 17,
      style: 'segments', breaks: 4, gap: 8, width: 7,
      colour: (STRIPE_COLOURS[2] || STRIPE_COLOURS[0]).name,
      accent: COLOURS[0].name,
      rim: 'Black', text: '', coverage: null
    };

    // ---- Helpers ----
    function $(sel) { return root.querySelector(sel); }
    function $all(sel) { return Array.prototype.slice.call(root.querySelectorAll(sel)); }
    function el(tag, attrs, parent) {
      var n = document.createElementNS(SVGNS, tag);
      for (var k in attrs) if (Object.prototype.hasOwnProperty.call(attrs, k)) n.setAttribute(k, attrs[k]);
      if (parent) parent.appendChild(n);
      return n;
    }
    function byName(list, name) {
      for (var i = 0; i < list.length; i++) if (list[i].name === name) return list[i];
      return list[0];
    }
    function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
    function cleanText(t) { return String(t || '').toUpperCase().replace(/[^A-Z0-9 &.\-!']/g, '').replace(/\s+/g, ' ').slice(0, 14); }
    function shade(hex, amt) {
      var h = hex.replace('#', '');
      if (h.length === 3) h = h.replace(/./g, '$&$&');
      var n = parseInt(h.slice(0, 6), 16);
      var r = clamp(((n >> 16) & 255) + amt, 0, 255), g = clamp(((n >> 8) & 255) + amt, 0, 255), b = clamp((n & 255) + amt, 0, 255);
      return '#' + ((1 << 24) | (r << 16) | (g << 8) | b).toString(16).slice(1);
    }
    function formatMoney(cents, format) {
      if (typeof cents !== 'number' || isNaN(cents)) return '';
      format = format || '\u00A3\x7b\x7bamount\x7d\x7d';
      function delim(num, precision, thousands, decimal) {
        var parts = (num / 100).toFixed(precision).split('.');
        parts[0] = parts[0].replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1' + thousands);
        return parts[1] ? parts[0] + decimal + parts[1] : parts[0];
      }
      return format.replace(/\{\{\s*(\w+)\s*\}\}/, function (_, key) {
        switch (key) {
          case 'amount_no_decimals': return delim(cents, 0, ',', '.');
          case 'amount_with_comma_separator': return delim(cents, 2, '.', ',');
          case 'amount_no_decimals_with_comma_separator': return delim(cents, 0, '.', ',');
          case 'amount_with_apostrophe_separator': return delim(cents, 2, "'", '.');
          default: return delim(cents, 2, ',', '.');
        }
