        }
      }

      wheel.classList.toggle('is-spinning', !!state.spin);
      var title = svg.querySelector('title');
      if (title) {
        title.textContent = (state.view === 'front' ? 'Front ' + state.front : 'Rear ' + state.rear) + ' inch ' + state.rim.toLowerCase() +
          ' wheel with ' + styleLabel().toLowerCase() + ' stripes in ' + state.colour + (state.text ? ', text "' + state.text + '"' : '');
      }
      $('[data-sd-code]').textContent = designCode();
    }
    function drawArc(parent, r, p, width, colour) {
      if (p[1] - p[0] >= 359.9) {
        el('circle', { cx: C, cy: C, r: r, fill: 'none', stroke: colour, 'stroke-width': width.toFixed(2) }, parent);
