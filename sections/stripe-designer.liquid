      return 'M' + outer.concat(inner).map(function (p) { return p[0].toFixed(2) + ' ' + p[1].toFixed(2); }).join(' L') + ' Z';
    }

    // Stripe width in preview px, to scale with the rim diameter.
    function stripePx(mm, inches) { return mm * (RIM_OUT / (inches * 25.4 / 2)); }

    function layout() {
      var text = state.text;
      var n = state.style === 'full' ? 1 : state.breaks;
      if (state.style === 'twin') n = state.breaks;
      var gap = n > 1 ? state.gap : 0;
      var inches = state.view === 'front' ? state.front : state.rear;
      var w = stripePx(state.width, inches);
      var fs = clamp(w * 1.55, 9, 16);
      if (text) {
        if (n < 2) n = 2;
