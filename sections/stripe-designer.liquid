    }

    // ---- Geometry: degrees clockwise from 12 o'clock ----
    var C = 200;
    var RIM_OUT = 156, RIM_IN = 124, STRIPE_R = 140;
    function pt(r, a) { var t = a * Math.PI / 180; return [C + r * Math.sin(t), C - r * Math.cos(t)]; }
    function arcPath(r, a0, a1) {
