    }
    function styleLabel() { for (var i = 0; i < STYLES.length; i++) if (STYLES[i].id === state.style) return STYLES[i].label; return ''; }
    function styleCode() { for (var i = 0; i < STYLES.length; i++) if (STYLES[i].id === state.style) return STYLES[i].code; return 'SEG'; }
    // Colour code from the name (Red -> RED, Gloss White -> GW) so reordering swatches never changes a code's meaning.
    function abbr(name) {
      var words = String(name).toUpperCase().replace(/[^A-Z0-9 ]/g, '').split(' ').filter(Boolean);
      if (!words.length) return 'X';
      return words.length > 1 ? words.map(function (w) { return w[0]; }).join('') : words[0].slice(0, 3);
    }
    function designCode() {
