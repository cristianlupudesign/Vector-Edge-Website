      return 'M' + p0[0].toFixed(2) + ' ' + p0[1].toFixed(2) + ' A' + r + ' ' + r + ' 0 ' + large + ' 1 ' + p1[0].toFixed(2) + ' ' + p1[1].toFixed(2);
    }
    function taperPath(r, a0, a1, w) {
      var steps = 48, outer = [], inner = [];
      for (var i = 0; i <= steps; i++) {
        var t = i / steps, a = a0 + (a1 - a0) * t;
        var hw = (w / 2) * Math.pow(Math.sin(Math.PI * t), 0.55);
