        state.text ? 'T' : ''
      ].filter(Boolean).join('-');
    }
    function usesAccent() { return state.style === 'twin' || !!state.text; }

    // ---- Build controls ----
    function fillSelect(sel, sizes, value) {
      sizes.forEach(function (s) {
        var o = document.createElement('option');
        o.value = s; o.textContent = s + '"';
        if (s === value) o.selected = true;
        sel.appendChild(o);
      });
    }
    function radio(container, name, value, labelHtml, checked, key) {
      var id = UID + '-' + name + '-' + String(value).replace(/[^a-z0-9]/gi, '');
      var input = document.createElement('input');
      input.type = 'radio'; input.name = UID + '-' + name; input.id = id; input.value = value;
      input.setAttribute('data-sd', key || name);
      if (checked) input.checked = true;
      var label = document.createElement('label');
      label.htmlFor = id;
      label.innerHTML = labelHtml;
      container.appendChild(input);
      container.appendChild(label);
      return { input: input, label: label };
    }
    function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }

    fillSelect($('[data-sd="front"]'), FRONT_SIZES, state.front);
    fillSelect($('[data-sd="rear"]'), REAR_SIZES, state.rear);
    STYLES.forEach(function (s) {
      radio($('[data-sd-styles]'), 'style', s.id, esc(s.label) + '<small>' + esc(s.hint) + '</small>', s.id === state.style);
    });
    WIDTHS.forEach(function (w) {
      radio($('[data-sd-widths]'), 'width', w, w + ' mm', w === state.width);
    });
    function swatches(key, list) {
      var box = $('[data-sd-swatches="' + key + '"]');
      list.forEach(function (c) {
        var r = radio(box, key, c.name, '', c.name === state[key]);
        r.label.style.background = c.hex;
        r.label.title = c.name;
        r.input.setAttribute('aria-label', c.name);
      });
    }
    swatches('colour', STRIPE_COLOURS);
    swatches('accent', COLOURS);
    swatches('rim', RIMS);

    // ---- Product / coverage ----
    var product = cfg.product;
    var variants = product && product.variants ? product.variants.filter(function (v) { return v.available !== false; }) : [];
    var STATIC_COVERAGE = ['Front & rear', 'Front only', 'Rear only'];
    var coverageBox = $('[data-sd-coverage]');
    if (variants.length > 1) {
      variants.forEach(function (v, i) {
        radio(coverageBox, 'coverage', v.id, esc(v.title) + '<small>' + esc(formatMoney(v.price, cfg.moneyFormat)) + '</small>', i === 0);
      });
      state.coverage = String(variants[0].id);
    } else {
      STATIC_COVERAGE.forEach(function (label, i) { radio(coverageBox, 'coverage', label, esc(label), i === 0); });
      state.coverage = STATIC_COVERAGE[0];
    }
    var addonVariant = null;
    if (cfg.addon && cfg.addon.variants) {
      for (var a = 0; a < cfg.addon.variants.length; a++) if (cfg.addon.variants[a].available !== false) { addonVariant = cfg.addon.variants[a]; break; }
    }
    function currentVariant() {
      if (!variants.length) return null;
      if (variants.length === 1) return variants[0];
      for (var i = 0; i < variants.length; i++) if (String(variants[i].id) === String(state.coverage)) return variants[i];
      return variants[0];
    }
    function coverageLabel() {
      var v = currentVariant();
      return variants.length > 1 && v ? v.title : state.coverage;
    }

    var submitBtn = $('[data-sd-submit]');
    var buttonLabel = submitBtn.textContent;
    function updatePrice() {
      var v = currentVariant();
      var box = $('[data-sd-pricebox]');
      if (!v) {
        box.hidden = true;
        submitBtn.textContent = 'Send design for a quote';
        return;
      }
      box.hidden = false;
      var withAddon = !!(state.text && addonVariant);
      $('[data-sd-price="kit"]').textContent = formatMoney(v.price, cfg.moneyFormat);
      $('[data-sd-price-addon-row]').hidden = !withAddon;
      if (withAddon) $('[data-sd-price="addon"]').textContent = formatMoney(addonVariant.price, cfg.moneyFormat);
      $('[data-sd-price="total"]').textContent = formatMoney(v.price + (withAddon ? addonVariant.price : 0), cfg.moneyFormat);
      submitBtn.textContent = buttonLabel;
    }

    // ---- UI sync ----
    function syncUi() {
      var multi = state.style !== 'full';
      var range = $('[data-sd="breaks"]');
      range.min = state.style === 'twin' ? 1 : 2;
      if (state.breaks < +range.min) state.breaks = +range.min;
      range.value = state.breaks;
      $('[data-sd-breaks-wrap]').hidden = !multi;
      $('[data-sd-gap-wrap]').hidden = !multi || state.breaks < 2;
      $('[data-sd="gap"]').value = state.gap;
      $('[data-sd-out="breaks"]').textContent = state.breaks === 1 ? 'Full' : state.breaks;
      $('[data-sd-out="gap"]').textContent = state.gap + '°';
      $('[data-sd-accent-wrap]').hidden = !usesAccent();
      $('[data-sd-accent-label]').textContent = state.style === 'twin' ? 'Inner line colour' : 'Text colour';
      ['colour', 'accent', 'rim'].forEach(function (k) {
        var nameEl = $('[data-sd-name="' + k + '"]');
        if (nameEl) nameEl.innerHTML = '<strong>' + esc(state[k]) + '</strong>';
      });
      updatePrice();
      render();
    }

    root.addEventListener('input', onChange);
    root.addEventListener('change', onChange);
    function onChange(e) {
      var key = e.target.getAttribute('data-sd');
      if (!key) return;
      var v = e.target.type === 'checkbox' ? e.target.checked : e.target.value;
      switch (key) {
        case 'front': case 'rear': state[key] = parseInt(v, 10); state.view = key; checkView(); break;
        case 'breaks': case 'gap': case 'width': state[key] = parseInt(v, 10); break;
        case 'text': state.text = cleanText(v); if (e.type === 'change') e.target.value = state.text; break;
        case 'bike': state.bike = String(v).trim().slice(0, 60); if (state.bike) showBikeError(false); break;
        default: state[key] = v;
      }
      syncUi();
    }
    function checkView() {
      var r = root.querySelector('[data-sd="view"][value="' + state.view + '"]');
      if (r) r.checked = true;
    }

    // ---- Shareable link (hash) ----
    function toHash() {
      var p = new URLSearchParams();
      p.set('s', state.style); p.set('n', state.breaks); p.set('g', state.gap); p.set('w', state.width);
      p.set('f', state.front); p.set('r', state.rear); p.set('c', state.colour); p.set('a', state.accent); p.set('rim', state.rim);
      if (state.text) p.set('t', state.text);
      return 'stripe&' + p.toString();
    }
    function fromHash() {
      var h = (location.hash || '').replace(/^#/, '');
      if (h.indexOf('stripe&') !== 0) return;
      var p = new URLSearchParams(h.slice(7));
      function num(k, lo, hi) { var n = parseInt(p.get(k), 10); return isNaN(n) ? null : clamp(n, lo, hi); }
      if (STYLES.some(function (s) { return s.id === p.get('s'); })) state.style = p.get('s');
      var n = num('n', 1, 8); if (n !== null) state.breaks = n;
      var g = num('g', 2, 24); if (g !== null) state.gap = g;
      var w = num('w', 1, 99); if (w !== null && WIDTHS.indexOf(w) > -1) state.width = w;
      var f = num('f', 1, 99); if (f !== null && FRONT_SIZES.indexOf(f) > -1) state.front = f;
      var r = num('r', 1, 99); if (r !== null && REAR_SIZES.indexOf(r) > -1) state.rear = r;
      if (STRIPE_COLOURS.some(function (c) { return c.name === p.get('c'); })) state.colour = p.get('c');
      if (COLOURS.some(function (c) { return c.name === p.get('a'); })) state.accent = p.get('a');
      if (RIMS.some(function (c) { return c.name === p.get('rim'); })) state.rim = p.get('rim');
      if (p.get('t')) state.text = cleanText(p.get('t'));
      // Reflect into controls
      $('[data-sd="front"]').value = state.front;
      $('[data-sd="rear"]').value = state.rear;
      var t = $('[data-sd="text"]'); if (t) t.value = state.text;
      ['style', 'width', 'colour', 'accent', 'rim'].forEach(function (k) {
        $all('[data-sd="' + k + '"]').forEach(function (i) { i.checked = String(i.value) === String(state[k]); });
      });
    }
    function shareUrl() { return location.href.split('#')[0] + '#' + toHash(); }
    $('[data-sd-share]').addEventListener('click', function () {
      var url = shareUrl();
      var btn = this;
      function done(ok) { btn.textContent = ok ? 'Link copied' : 'Copy failed'; setTimeout(function () { btn.textContent = 'Copy design link'; }, 2000); }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(function () { done(true); }, function () { done(false); });
      } else {
        try { history.replaceState(null, '', url); done(true); } catch (e) { done(false); }
      }
    });

    // ---- Submit ----
    var status = $('[data-sd-status]');
    function setStatus(msg, isError) { status.textContent = msg; status.classList.toggle('is-error', !!isError); }
    function showBikeError(show) {
      var input = $('[data-sd="bike"]');
      $('[data-sd-bike-err]').hidden = !show;
      input.setAttribute('aria-invalid', show ? 'true' : 'false');
    }
    function properties() {
      var L = layout();
      var props = {
        'Bike': state.bike,
        'Front wheel': state.front + '"',
        'Rear wheel': state.rear + '"',
        'Style': styleLabel(),
        'Pieces per side': L.n === 1 ? 'Full ring' : String(L.n),
        'Stripe width': state.width + ' mm',
        'Stripe colour': state.colour
      };
      if (L.n > 1) props['Gap'] = Math.round(L.gap) + '°';
      if (state.style === 'twin') props['Inner line colour'] = state.accent;
      if (state.text) { props['Rim text'] = state.text; props['Text colour'] = state.accent; }
      props['Rim colour'] = state.rim;
      if (variants.length <= 1) props['Kit'] = coverageLabel();
      props['Design code'] = designCode();
      props['_Design link'] = shareUrl();
      return props;
    }

    $('[data-sd-form]').addEventListener('submit', function (e) {
      e.preventDefault();
      if (!state.bike) {
        showBikeError(true);
        $('[data-sd="bike"]').focus();
        return;
      }
      var v = currentVariant();
      if (!v) {
        var q = new URLSearchParams({ design: designCode(), bike: state.bike, link: shareUrl() });
        location.href = cfg.quoteUrl + (cfg.quoteUrl.indexOf('?') > -1 ? '&' : '?') + q.toString();
        return;
      }
      var props = properties();
      var items = [{ id: v.id, quantity: 1, properties: props }];
      if (state.text && addonVariant) {
        items.push({ id: addonVariant.id, quantity: 1, properties: { 'For design': props['Design code'], 'Rim text': state.text } });
      }
      submitBtn.disabled = true;
      setStatus('Adding your kit to the basket...');
      fetch(cfg.cartAddUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: items })
      }).then(function (res) {
        return res.json().then(function (data) { return { ok: res.ok, data: data }; });
      }).then(function (r) {
        if (!r.ok) throw new Error((r.data && (r.data.description || r.data.message)) || 'Could not add to basket');
        try {
          if (window.dataLayer && typeof window.dataLayer.push === 'function') {
            window.dataLayer.push({ event: 'sd_add_to_cart', design: props['Design code'], style: state.style });
          }
        } catch (err) {}
        if (cfg.afterAdd === 'cart') {
          location.href = cfg.cartUrl;
        } else {
          setStatus('Added to your basket.');
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          submitBtn.disabled = false;
        }
      }).catch(function (err) {
        setStatus(err.message || 'Something went wrong. Please try again.', true);
        submitBtn.disabled = false;
      });
    });

    fromHash();
    checkView();
    syncUi();
  })();
</script>

