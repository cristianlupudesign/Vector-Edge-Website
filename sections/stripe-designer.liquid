      return { n: n, gap: gap, w: w, fs: fs, step: 360 / n, offset: text ? 0 : -90 / n };
    }

    // ---- Render ----
    var wheel = $('[data-sd-wheel]');
    var svg = $('[data-sd-svg]');
    var fixed = $('[data-sd-fixed]');
    function render() {
      while (wheel.firstChild) wheel.removeChild(wheel.firstChild);
      while (fixed.firstChild) fixed.removeChild(fixed.firstChild);
      var rim = byName(RIMS, state.rim).hex;
      var colour = byName(COLOURS, state.colour).hex;
      var accent = byName(COLOURS, state.accent).hex;
      var L = layout();

      // Tyre
      el('circle', { cx: C, cy: C, r: 197, fill: '#151515' }, wheel);
      el('circle', { cx: C, cy: C, r: 191, fill: 'none', stroke: '#262626', 'stroke-width': 9, 'stroke-dasharray': '7 5' }, wheel);
      el('circle', { cx: C, cy: C, r: 176, fill: '#1e1e1e' }, wheel);
      el('circle', { cx: C, cy: C, r: 161, fill: '#111' }, wheel);

      // Rim lip
      el('circle', { cx: C, cy: C, r: RIM_OUT, fill: rim }, wheel);
      el('circle', { cx: C, cy: C, r: RIM_OUT - 1, fill: 'none', stroke: shade(rim, 40), 'stroke-width': 1.5, opacity: 0.6 }, wheel);
      el('circle', { cx: C, cy: C, r: RIM_IN, fill: '#0c0c0c' }, wheel);
      el('circle', { cx: C, cy: C, r: RIM_IN + 0.5, fill: 'none', stroke: shade(rim, -40), 'stroke-width': 2 }, wheel);

      // Brake disc (front) or sprocket (rear), behind the spokes
      if (state.view === 'front') {
        el('circle', { cx: C, cy: C, r: 98, fill: '#8f9296' }, wheel);
        el('circle', { cx: C, cy: C, r: 92, fill: 'none', stroke: '#6f7276', 'stroke-width': 2, 'stroke-dasharray': '2 9' }, wheel);
        el('circle', { cx: C, cy: C, r: 66, fill: '#2a2a2c' }, wheel);
        el('rect', { x: C + 92, y: C - 48, width: 26, height: 60, rx: 6, fill: '#c0201f', transform: 'rotate(30 ' + C + ' ' + C + ')' }, fixed);
      } else {
        el('circle', { cx: C, cy: C, r: 82, fill: 'none', stroke: '#5e6166', 'stroke-width': 10, 'stroke-dasharray': '6 4' }, wheel);
        el('circle', { cx: C, cy: C, r: 76, fill: '#5e6166' }, wheel);
        el('circle', { cx: C, cy: C, r: 58, fill: '#2a2a2c' }, wheel);
      }

      // Split five-spoke cast wheel
      for (var s = 0; s < 5; s++) {
        var base = s * 72;
        [-7, 7].forEach(function (d) {
          var a = base + d;
          var p1 = pt(38, a - 9), p2 = pt(38, a + 9), p3 = pt(RIM_IN + 2, a + d * 0.55 + 3), p4 = pt(RIM_IN + 2, a + d * 0.55 - 3);
          el('path', {
            d: 'M' + p1.join(' ') + ' L' + p4.join(' ') + ' L' + p3.join(' ') + ' L' + p2.join(' ') + ' Z',
            fill: rim, stroke: shade(rim, -30), 'stroke-width': 1
          }, wheel);
        });
      }
      el('circle', { cx: C, cy: C, r: 40, fill: rim, stroke: shade(rim, -30), 'stroke-width': 1 }, wheel);
      el('circle', { cx: C, cy: C, r: 16, fill: '#7b7e82' }, wheel);
      el('circle', { cx: C, cy: C, r: 7, fill: '#2a2a2c' }, wheel);

      // Stripes
      var g = el('g', { 'stroke-linecap': 'butt' }, wheel);
      var pieces = [];
      if (L.n === 1) {
        pieces.push([0, 360]);
      } else {
        for (var i = 0; i < L.n; i++) {
          var gc = L.offset + i * L.step;
          pieces.push([gc + L.gap / 2, gc + L.step - L.gap / 2]);
        }
      }
      pieces.forEach(function (p) {
        if (state.style === 'tapered') {
          el('path', { d: taperPath(STRIPE_R, p[0], p[1], L.w), fill: colour }, g);
        } else if (state.style === 'twin') {
          var lw = L.w * 0.4, off = L.w * 0.32;
          drawArc(g, STRIPE_R + off, p, lw, colour);
          drawArc(g, STRIPE_R - off, p, lw, accent);
        } else {
          drawArc(g, STRIPE_R, p, L.w, colour);
        }
      });

      // Rim text, centred in each gap
      if (state.text) {
        var pathId = UID + '-textpath';
        // Path starts mid-piece so no word ever straddles the join.
        var start = L.offset + L.step / 2;
        var baseR = STRIPE_R - L.fs * 0.34;
        var d = arcPath(baseR, start, start + 180) + ' ' + arcPath(baseR, start + 180, start + 359.99).replace(/^M[^A]+/, '');
        var defs = el('defs', {}, wheel);
        el('path', { id: pathId, d: d }, defs);
        var circ = 2 * Math.PI * baseR;
        for (var j = 0; j < L.n; j++) {
          var gapCentre = L.offset + j * L.step;
          var rel = ((gapCentre - start) % 360 + 360) % 360;
          var t = el('text', {
            fill: accent, 'font-size': L.fs.toFixed(1), 'font-weight': 800,
            'font-family': 'Impact, "Arial Narrow Bold", "Arial Black", sans-serif', 'letter-spacing': '0.6'
          }, wheel);
          var tp = el('textPath', { href: '#' + pathId, startOffset: (rel / 360 * circ).toFixed(2), 'text-anchor': 'middle' }, t);
          tp.setAttributeNS('http://www.w3.org/1999/xlink', 'xlink:href', '#' + pathId);
